{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme",
  "title": "WonsildFoundation — Editorial theme",
  "description": "Editorial light/dark palette, bundled font and shared spacing/layout styles.",
  "dependencies": [
    "tw-animate-css@1.4.0",
    "@fontsource-variable/dm-sans@5.3.0"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "var(--ef-font-sans)",
      "font-serif": "var(--ef-font-serif)",
      "font-mono": "var(--ef-font-mono)",
      "color-destructive-foreground": "var(--destructive-foreground)",
      "radius-xs": "var(--radius)",
      "radius-sm": "var(--radius)",
      "radius-md": "var(--radius)",
      "radius-lg": "var(--radius)",
      "radius-xl": "var(--radius)"
    },
    "light": {
      "radius": "0.125rem",
      "ef-label-gap": "0.5rem",
      "ef-related-gap": "0.75rem",
      "ef-group-gap": "1.5rem",
      "ef-region-gap": "2.5rem",
      "ef-section-gap": "4rem",
      "ef-page-gutter": "clamp(1.5rem, 4vw, 3rem)",
      "ef-page-max": "80rem",
      "ef-reading-max": "65ch",
      "background": "#fafaf7",
      "foreground": "#20251f",
      "card": "#f0f1ec",
      "card-foreground": "#20251f",
      "popover": "#fafaf7",
      "popover-foreground": "#20251f",
      "primary": "#20251f",
      "primary-foreground": "#fafaf7",
      "secondary": "#f0f1ec",
      "secondary-foreground": "#20251f",
      "muted": "#f0f1ec",
      "muted-foreground": "#62685f",
      "accent": "#dbe8bf",
      "accent-foreground": "#20251f",
      "destructive": "#a52f36",
      "destructive-foreground": "#ffffff",
      "border": "#d6d9ce",
      "input": "#7b8374",
      "ring": "#344f35",
      "chart-1": "#344f35",
      "chart-2": "#2946bc",
      "chart-3": "#8b4432",
      "chart-4": "#735082",
      "chart-5": "#376f79",
      "sidebar": "#f0f1ec",
      "sidebar-foreground": "#20251f",
      "sidebar-primary": "#20251f",
      "sidebar-primary-foreground": "#fafaf7",
      "sidebar-accent": "#dbe8bf",
      "sidebar-accent-foreground": "#20251f",
      "sidebar-border": "#d6d9ce",
      "sidebar-ring": "#344f35",
      "ef-font-sans": "\"DM Sans Variable\", \"Helvetica Neue\", Arial, sans-serif",
      "ef-font-serif": "Georgia, serif",
      "ef-font-mono": "ui-monospace, monospace",
      "ef-font-display": "var(--ef-font-sans)",
      "ef-heading-tracking": "-0.04em",
      "ef-display-tracking": "-0.05em",
      "ef-eyebrow-font": "inherit",
      "ef-eyebrow-case": "none",
      "ef-eyebrow-tracking": "normal"
    },
    "dark": {
      "background": "#191b1a",
      "foreground": "#eef0e8",
      "card": "#252823",
      "card-foreground": "#eef0e8",
      "popover": "#252823",
      "popover-foreground": "#eef0e8",
      "primary": "#eef0e8",
      "primary-foreground": "#191b1a",
      "secondary": "#252823",
      "secondary-foreground": "#eef0e8",
      "muted": "#252823",
      "muted-foreground": "#acb3a4",
      "accent": "#374825",
      "accent-foreground": "#eef0e8",
      "destructive": "#ff9599",
      "destructive-foreground": "#381013",
      "border": "#41483c",
      "input": "#919985",
      "ring": "#b7d6a4",
      "chart-1": "#b7d6a4",
      "chart-2": "#b5c2ff",
      "chart-3": "#e8b4a4",
      "chart-4": "#d7b3e2",
      "chart-5": "#9cd3dc",
      "sidebar": "#252823",
      "sidebar-foreground": "#eef0e8",
      "sidebar-primary": "#eef0e8",
      "sidebar-primary-foreground": "#191b1a",
      "sidebar-accent": "#374825",
      "sidebar-accent-foreground": "#eef0e8",
      "sidebar-border": "#41483c",
      "sidebar-ring": "#b7d6a4"
    }
  },
  "css": {
    "@import \"tw-animate-css\"": {},
    "@layer base": {
      "*": {
        "@apply border-border": {}
      },
      "html": {
        "font-family": "var(--font-sans)",
        "color-scheme": "light"
      },
      "html.dark": {
        "color-scheme": "dark"
      },
      "body": {
        "margin": "0",
        "background": "var(--background)",
        "color": "var(--foreground)",
        "font-size": "1rem",
        "line-height": "1.5"
      },
      "button, a, input, select, textarea": {
        "-webkit-tap-highlight-color": "transparent"
      }
    },
    "@import \"@fontsource-variable/dm-sans\"": {},
    "@layer components": {
      ".ef-system": {
        "font-family": "var(--font-sans)",
        "color": "var(--foreground)",
        "background": "var(--background)"
      },
      ".ef-page": {
        "width": "100%",
        "max-width": "var(--ef-page-max)",
        "margin-inline": "auto",
        "padding-inline": "var(--ef-page-gutter)",
        "padding-block": "var(--ef-region-gap)"
      },
      ".ef-stack": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "var(--ef-group-gap)",
        "min-width": "0"
      },
      ".ef-stack > [data-slot=\"button\"]": {
        "align-self": "flex-start"
      },
      ".ef-stack[data-align=\"start\"]": {
        "align-items": "flex-start"
      },
      ".ef-stack[data-align=\"stretch\"] > [data-slot=\"button\"]": {
        "align-self": "stretch"
      },
      ".ef-cluster": {
        "display": "flex",
        "align-items": "center",
        "flex-wrap": "wrap",
        "gap": "var(--ef-related-gap)"
      },
      ".ef-grid": {
        "display": "grid",
        "grid-template-columns": "repeat(auto-fit, minmax(min(100%, 18rem), 1fr))",
        "gap": "var(--ef-group-gap)"
      },
      ".ef-stack > *, .ef-grid > *, .ef-cluster > *": {
        "min-width": "0"
      },
      ".ef-gap-label": {
        "gap": "var(--ef-label-gap)"
      },
      ".ef-gap-related": {
        "gap": "var(--ef-related-gap)"
      },
      ".ef-gap-group": {
        "gap": "var(--ef-group-gap)"
      },
      ".ef-gap-region": {
        "gap": "var(--ef-region-gap)"
      },
      ".ef-gap-section": {
        "gap": "var(--ef-section-gap)"
      },
      ".ef-heading": {
        "margin": "0",
        "font-family": "var(--font-sans)",
        "text-wrap": "balance",
        "overflow-wrap": "break-word"
      },
      ".ef-heading-item": {
        "font-size": "1rem",
        "line-height": "1.5",
        "font-weight": "500"
      },
      ".ef-body": {
        "font-size": "1rem",
        "line-height": "1.5"
      },
      ".ef-lede": {
        "font-size": "1.125rem",
        "line-height": "1.5"
      },
      ".ef-caption": {
        "font-size": ".875rem",
        "line-height": "1.5",
        "color": "var(--muted-foreground)"
      },
      ".ef-numeric": {
        "font-variant-numeric": "tabular-nums"
      },
      ".ef-heading-group": {
        "font-size": "1.25rem",
        "line-height": "1.4",
        "font-weight": "500",
        "letter-spacing": "-0.02em"
      },
      ".ef-heading-page": {
        "font-size": "clamp(2rem, 4vw, 3rem)",
        "line-height": "1.1",
        "font-weight": "400",
        "letter-spacing": "var(--ef-heading-tracking)"
      },
      ".ef-heading-display": {
        "font-family": "var(--ef-font-display)",
        "font-size": "clamp(2.5rem, 6vw, 4.5rem)",
        "line-height": "1.05",
        "font-weight": "400",
        "letter-spacing": "var(--ef-display-tracking)"
      },
      ".ef-prose": {
        "max-width": "var(--ef-reading-max)",
        "font-size": "1rem",
        "line-height": "1.5"
      },
      ".ef-page-header": {
        "display": "flex",
        "align-items": "flex-end",
        "justify-content": "space-between",
        "gap": "var(--ef-group-gap)"
      },
      ".ef-page-header > div": {
        "min-width": "0",
        "max-width": "100%"
      },
      ".ef-page-description": {
        "margin-top": "1rem",
        "color": "var(--muted-foreground)",
        "max-width": "48ch",
        "font-size": "1rem",
        "line-height": "1.5"
      },
      ".ef-eyebrow": {
        "font-family": "var(--ef-eyebrow-font)",
        "text-transform": "var(--ef-eyebrow-case)",
        "letter-spacing": "var(--ef-eyebrow-tracking)",
        "margin-bottom": "0.75rem",
        "font-size": "0.875rem",
        "color": "var(--muted-foreground)"
      },
      ".ef-line-choice, [data-slot=\"tabs-list\"][data-variant=\"line\"] [data-slot=\"tabs-trigger\"]": {
        "position": "relative"
      },
      ".ef-line-choice::after, [data-slot=\"tabs-list\"][data-variant=\"line\"] [data-slot=\"tabs-trigger\"]::after": {
        "content": "''",
        "position": "absolute",
        "inset-inline": "0",
        "bottom": "0",
        "height": "2px",
        "background": "var(--foreground)",
        "opacity": "0"
      },
      ".ef-line-choice[aria-pressed=\"true\"], [data-slot=\"tabs-list\"][data-variant=\"line\"] [data-slot=\"tabs-trigger\"][data-state=\"active\"]": {
        "color": "var(--foreground)"
      },
      ".ef-line-choice[aria-pressed=\"true\"]::after, [data-slot=\"tabs-list\"][data-variant=\"line\"] [data-slot=\"tabs-trigger\"][data-state=\"active\"]::after": {
        "opacity": "1"
      },
      "[data-slot=\"tabs\"][data-orientation=\"vertical\"] [data-slot=\"tabs-list\"][data-variant=\"line\"] [data-slot=\"tabs-trigger\"]::after": {
        "inset-inline": "auto 0",
        "inset-block": "0",
        "width": "2px",
        "height": "auto"
      },
      ".ef-field": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "var(--ef-label-gap)",
        "min-width": "0"
      },
      ".ef-field-hint, .ef-field-error": {
        "font-size": "0.875rem",
        "line-height": "1.5",
        "margin": "0"
      },
      ".ef-field-hint": {
        "color": "var(--muted-foreground)"
      },
      ".ef-field-error": {
        "color": "var(--destructive)"
      },
      ".ef-field > [data-slot=\"select-trigger\"]": {
        "width": "100%"
      },
      ".ef-empty-state": {
        "padding-block": "var(--ef-region-gap)",
        "border-block": "1px solid var(--border)",
        "min-width": "0"
      },
      ".ef-empty-state[data-edge=\"bottom\"]": {
        "border-top": "0"
      },
      ".ef-empty-state[data-edge=\"none\"]": {
        "border-block": "0"
      },
      ".ef-empty-action": {
        "margin-top": "var(--ef-related-gap)"
      },
      ".ef-copy-command": {
        "min-width": "0"
      },
      ".ef-copy-command-row": {
        "display": "flex",
        "flex-wrap": "wrap",
        "align-items": "flex-start",
        "gap": "var(--ef-related-gap)",
        "padding-block": "var(--ef-related-gap)"
      },
      ".ef-copy-command code": {
        "flex": "1 1 16rem",
        "min-width": "0",
        "overflow-wrap": "anywhere",
        "white-space": "pre-wrap",
        "font-size": ".875rem",
        "line-height": "1.5",
        "padding-block": ".625rem"
      },
      ".ef-copy-command-status": {
        "min-height": "1.5em",
        "font-size": ".875rem",
        "line-height": "1.5",
        "color": "var(--muted-foreground)"
      },
      "@media (prefers-reduced-motion: reduce)": {
        "[data-slot=\"dialog-content\"], [data-slot=\"dialog-overlay\"], [data-slot=\"select-content\"], [data-slot=\"switch-thumb\"], [data-slot=\"button\"]": {
          "animation": "none",
          "transition": "none"
        }
      },
      "@media (max-width: 40rem)": {
        ".ef-page, .ef-system": {
          "--ef-section-gap": "2.5rem",
          "--ef-region-gap": "2rem"
        },
        ".ef-page-header": {
          "align-items": "flex-start",
          "flex-direction": "column"
        }
      }
    }
  },
  "meta": {
    "version": "0.5.1"
  },
  "docs": "Use CSS variables with Tailwind v4. The foundation styles use ef- class names. The theme does not replace existing components or change business logic.",
  "type": "registry:theme"
}