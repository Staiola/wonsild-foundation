{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "stone-theme",
  "title": "Stone theme",
  "description": "Warm stone, charcoal and yellow with Geist, Geist Mono and Source Serif 4.",
  "dependencies": [
    "@fontsource-variable/geist@5.3.0",
    "@fontsource-variable/geist-mono@5.3.0",
    "@fontsource-variable/source-serif-4@5.3.0"
  ],
  "cssVars": {
    "theme": {
      "font-sans": "var(--ef-font-sans)",
      "font-serif": "var(--ef-font-serif)",
      "font-mono": "var(--ef-font-mono)",
      "color-destructive-foreground": "var(--destructive-foreground)"
    },
    "light": {
      "radius": "0.125rem",
      "ef-label-gap": "0.5rem",
      "ef-related-gap": "0.75rem",
      "ef-group-gap": "1.5rem",
      "ef-region-gap": "2.5rem",
      "ef-section-gap": "4rem",
      "ef-page-gutter": "clamp(1.5rem, 4vw, 3rem)",
      "ef-page-max": "80rem",
      "ef-reading-max": "65ch",
      "background": "#e3e0d9",
      "foreground": "#1d1d1b",
      "card": "#d6d2c8",
      "card-foreground": "#1d1d1b",
      "popover": "#f0f0f0",
      "popover-foreground": "#1d1d1b",
      "primary": "#1d1d1b",
      "primary-foreground": "#f0f0f0",
      "secondary": "#d6d2c8",
      "secondary-foreground": "#1d1d1b",
      "muted": "#d6d2c8",
      "muted-foreground": "#58564f",
      "accent": "#ffbd01",
      "accent-foreground": "#1d1d1b",
      "destructive": "#a52f36",
      "destructive-foreground": "#ffffff",
      "border": "#b6b2a8",
      "input": "#7a766d",
      "ring": "#62500d",
      "chart-1": "#766000",
      "chart-2": "#3f5c6f",
      "chart-3": "#8d4938",
      "chart-4": "#6d5771",
      "chart-5": "#4a6550",
      "sidebar": "#d6d2c8",
      "sidebar-foreground": "#1d1d1b",
      "sidebar-primary": "#1d1d1b",
      "sidebar-primary-foreground": "#f0f0f0",
      "sidebar-accent": "#ffbd01",
      "sidebar-accent-foreground": "#1d1d1b",
      "sidebar-border": "#b6b2a8",
      "sidebar-ring": "#62500d",
      "ef-font-sans": "\"Geist Variable\", \"Helvetica Neue\", Arial, sans-serif",
      "ef-font-serif": "\"Source Serif 4 Variable\", Georgia, serif",
      "ef-font-mono": "\"Geist Mono Variable\", ui-monospace, monospace",
      "ef-font-display": "var(--ef-font-serif)",
      "ef-heading-tracking": "-0.025em",
      "ef-display-tracking": "-0.025em",
      "ef-eyebrow-font": "var(--ef-font-mono)",
      "ef-eyebrow-case": "uppercase",
      "ef-eyebrow-tracking": "0.04em"
    },
    "dark": {
      "background": "#1d1d1b",
      "foreground": "#f0f0f0",
      "card": "#2b2b28",
      "card-foreground": "#f0f0f0",
      "popover": "#2b2b28",
      "popover-foreground": "#f0f0f0",
      "primary": "#f0f0f0",
      "primary-foreground": "#1d1d1b",
      "secondary": "#2b2b28",
      "secondary-foreground": "#f0f0f0",
      "muted": "#2b2b28",
      "muted-foreground": "#b9b5ac",
      "accent": "#ffbd01",
      "accent-foreground": "#1d1d1b",
      "destructive": "#ff9599",
      "destructive-foreground": "#381013",
      "border": "#494840",
      "input": "#99958b",
      "ring": "#ffbd01",
      "chart-1": "#ffbd01",
      "chart-2": "#aac6d7",
      "chart-3": "#e3aa99",
      "chart-4": "#cdb2d4",
      "chart-5": "#adc5af",
      "sidebar": "#2b2b28",
      "sidebar-foreground": "#f0f0f0",
      "sidebar-primary": "#f0f0f0",
      "sidebar-primary-foreground": "#1d1d1b",
      "sidebar-accent": "#ffbd01",
      "sidebar-accent-foreground": "#1d1d1b",
      "sidebar-border": "#494840",
      "sidebar-ring": "#ffbd01"
    }
  },
  "css": {
    "@import \"@fontsource-variable/geist\"": {},
    "@import \"@fontsource-variable/geist-mono\"": {},
    "@import \"@fontsource-variable/source-serif-4\"": {},
    "@layer components": {
      ".ef-system": {
        "font-family": "var(--font-sans)",
        "color": "var(--foreground)",
        "background": "var(--background)"
      },
      ".ef-page": {
        "width": "100%",
        "max-width": "var(--ef-page-max)",
        "margin-inline": "auto",
        "padding-inline": "var(--ef-page-gutter)",
        "padding-block": "var(--ef-region-gap)"
      },
      ".ef-stack": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "var(--ef-group-gap)",
        "min-width": "0"
      },
      ".ef-cluster": {
        "display": "flex",
        "align-items": "center",
        "flex-wrap": "wrap",
        "gap": "var(--ef-related-gap)"
      },
      ".ef-grid": {
        "display": "grid",
        "grid-template-columns": "repeat(auto-fit, minmax(min(100%, 18rem), 1fr))",
        "gap": "var(--ef-group-gap)"
      },
      ".ef-stack > *, .ef-grid > *, .ef-cluster > *": {
        "min-width": "0"
      },
      ".ef-gap-label": {
        "gap": "var(--ef-label-gap)"
      },
      ".ef-gap-related": {
        "gap": "var(--ef-related-gap)"
      },
      ".ef-gap-group": {
        "gap": "var(--ef-group-gap)"
      },
      ".ef-gap-region": {
        "gap": "var(--ef-region-gap)"
      },
      ".ef-gap-section": {
        "gap": "var(--ef-section-gap)"
      },
      ".ef-heading": {
        "margin": "0",
        "font-family": "var(--font-sans)",
        "text-wrap": "balance",
        "overflow-wrap": "break-word"
      },
      ".ef-heading-group": {
        "font-size": "1.25rem",
        "line-height": "1.4",
        "font-weight": "500",
        "letter-spacing": "-0.02em"
      },
      ".ef-heading-page": {
        "font-size": "clamp(2rem, 4vw, 3rem)",
        "line-height": "1.1",
        "font-weight": "400",
        "letter-spacing": "var(--ef-heading-tracking)"
      },
      ".ef-heading-display": {
        "font-family": "var(--ef-font-display)",
        "font-size": "clamp(2.5rem, 6vw, 4.5rem)",
        "line-height": "1.05",
        "font-weight": "400",
        "letter-spacing": "var(--ef-display-tracking)"
      },
      ".ef-prose": {
        "max-width": "var(--ef-reading-max)",
        "font-size": "1rem",
        "line-height": "1.5"
      },
      ".ef-page-header": {
        "display": "flex",
        "align-items": "flex-end",
        "justify-content": "space-between",
        "gap": "var(--ef-group-gap)"
      },
      ".ef-page-header > div": {
        "min-width": "0",
        "max-width": "100%"
      },
      ".ef-page-description": {
        "margin-top": "1rem",
        "color": "var(--muted-foreground)",
        "max-width": "48ch",
        "font-size": "1rem",
        "line-height": "1.5"
      },
      ".ef-eyebrow": {
        "font-family": "var(--ef-eyebrow-font)",
        "text-transform": "var(--ef-eyebrow-case)",
        "letter-spacing": "var(--ef-eyebrow-tracking)",
        "margin-bottom": "0.75rem",
        "font-size": "0.875rem",
        "color": "var(--muted-foreground)"
      },
      ".ef-field": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "var(--ef-label-gap)",
        "min-width": "0"
      },
      ".ef-field-hint, .ef-field-error": {
        "font-size": "0.875rem",
        "line-height": "1.5",
        "margin": "0"
      },
      ".ef-field-hint": {
        "color": "var(--muted-foreground)"
      },
      ".ef-field-error": {
        "color": "var(--destructive)"
      },
      ".ef-field > [data-slot=\"select-trigger\"]": {
        "width": "100%"
      },
      ".ef-empty-state": {
        "padding-block": "var(--ef-region-gap)",
        "border-block": "1px solid var(--border)",
        "min-width": "0"
      },
      ".ef-empty-action": {
        "margin-top": "var(--ef-related-gap)"
      },
      ".ef-copy-command": {
        "min-width": "0"
      },
      ".ef-copy-command-row": {
        "display": "flex",
        "flex-wrap": "wrap",
        "align-items": "flex-start",
        "gap": "var(--ef-related-gap)",
        "padding-block": "var(--ef-related-gap)"
      },
      ".ef-copy-command code": {
        "flex": "1 1 16rem",
        "min-width": "0",
        "overflow-wrap": "anywhere",
        "white-space": "pre-wrap",
        "font-size": ".875rem",
        "line-height": "1.7"
      },
      ".ef-copy-command-status": {
        "min-height": "1.5em",
        "font-size": ".875rem",
        "line-height": "1.5",
        "color": "var(--muted-foreground)"
      },
      ".ef-system [data-slot=\"button\"], .ef-system [data-slot=\"input\"], .ef-system [data-slot=\"select-trigger\"]": {
        "min-height": "2.75rem"
      },
      ".ef-system [data-slot=\"button\"]": {
        "box-shadow": "none",
        "cursor": "pointer"
      },
      ".ef-system [data-slot=\"button\"]:disabled": {
        "cursor": "not-allowed"
      },
      ".ef-system [data-slot=\"input\"], .ef-system [data-slot=\"select-trigger\"]": {
        "font-size": "1rem",
        "box-shadow": "none"
      },
      ".ef-system [data-slot=\"switch\"]": {
        "cursor": "pointer"
      },
      ".ef-system [data-slot=\"label\"]": {
        "font-size": "0.875rem",
        "font-weight": "500",
        "line-height": "1.4"
      },
      "@media (prefers-reduced-motion: reduce)": {
        "[data-slot=\"dialog-content\"], [data-slot=\"dialog-overlay\"], [data-slot=\"select-content\"], [data-slot=\"switch-thumb\"], [data-slot=\"button\"]": {
          "animation": "none",
          "transition": "none"
        }
      },
      "@media (max-width: 40rem)": {
        ".ef-page, .ef-system": {
          "--ef-section-gap": "2.5rem",
          "--ef-region-gap": "2rem"
        },
        ".ef-page-header": {
          "align-items": "flex-start",
          "flex-direction": "column"
        }
      }
    }
  },
  "docs": "A separate theme in the Editorial Foundation family. Use CSS variables with Tailwind v4. This changes shared tokens, fonts and layout CSS. Review local styles before installing.",
  "type": "registry:theme"
}