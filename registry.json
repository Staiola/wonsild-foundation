{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "editorial-foundation",
  "homepage": "https://github.com/Staiola/editorial-foundation",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Editorial theme",
      "description": "Editorial light/dark palette, bundled font and shared spacing/layout styles.",
      "dependencies": [
        "@fontsource-variable/dm-sans@5.3.0"
      ],
      "cssVars": {
        "theme": {
          "font-sans": "\"DM Sans Variable\", \"Helvetica Neue\", Arial, sans-serif",
          "color-destructive-foreground": "var(--destructive-foreground)"
        },
        "light": {
          "radius": "0.25rem",
          "ef-label-gap": "0.5rem",
          "ef-related-gap": "0.75rem",
          "ef-group-gap": "1.5rem",
          "ef-region-gap": "2.5rem",
          "ef-section-gap": "4rem",
          "ef-page-gutter": "clamp(1.5rem, 4vw, 3rem)",
          "ef-page-max": "80rem",
          "ef-reading-max": "65ch",
          "background": "#fafaf7",
          "foreground": "#20251f",
          "card": "#f0f1ec",
          "card-foreground": "#20251f",
          "popover": "#fafaf7",
          "popover-foreground": "#20251f",
          "primary": "#20251f",
          "primary-foreground": "#fafaf7",
          "secondary": "#f0f1ec",
          "secondary-foreground": "#20251f",
          "muted": "#f0f1ec",
          "muted-foreground": "#62685f",
          "accent": "#dbe8bf",
          "accent-foreground": "#20251f",
          "destructive": "#a52f36",
          "destructive-foreground": "#ffffff",
          "border": "#d6d9ce",
          "input": "#7b8374",
          "ring": "#344f35",
          "chart-1": "#344f35",
          "chart-2": "#2946bc",
          "chart-3": "#8b4432",
          "chart-4": "#735082",
          "chart-5": "#376f79",
          "sidebar": "#f0f1ec",
          "sidebar-foreground": "#20251f",
          "sidebar-primary": "#20251f",
          "sidebar-primary-foreground": "#fafaf7",
          "sidebar-accent": "#dbe8bf",
          "sidebar-accent-foreground": "#20251f",
          "sidebar-border": "#d6d9ce",
          "sidebar-ring": "#344f35"
        },
        "dark": {
          "background": "#191b1a",
          "foreground": "#eef0e8",
          "card": "#252823",
          "card-foreground": "#eef0e8",
          "popover": "#252823",
          "popover-foreground": "#eef0e8",
          "primary": "#eef0e8",
          "primary-foreground": "#191b1a",
          "secondary": "#252823",
          "secondary-foreground": "#eef0e8",
          "muted": "#252823",
          "muted-foreground": "#acb3a4",
          "accent": "#374825",
          "accent-foreground": "#eef0e8",
          "destructive": "#ff9599",
          "destructive-foreground": "#381013",
          "border": "#41483c",
          "input": "#919985",
          "ring": "#b7d6a4",
          "chart-1": "#b7d6a4",
          "chart-2": "#b5c2ff",
          "chart-3": "#e8b4a4",
          "chart-4": "#d7b3e2",
          "chart-5": "#9cd3dc",
          "sidebar": "#252823",
          "sidebar-foreground": "#eef0e8",
